    "serp_youtube_video_subtitles": {
      "video_id": "exBk002xxxx",
      "subtitles_language": "en",
      "items": [
        {
          "start_time": 0.0,
          "text": "If clients forget their appointments, this video is for you."
        },
        {
          "start_time": 6.4,
          "text": "We will set up reminder texts once, and they go out before every visit on their own."
        },
        {
          "start_time": 14.9,
          "text": "Our customers tell us they see fewer no-shows once reminders are on."
        },
        {
          "start_time": 24.2,
          "text": "Let's start in the settings."
        },
        {
          "start_time": 38.6,
          "text": "Open Settings, then Reminders, and switch on automatic reminders."
        },
        {
          "start_time": 49.1,
          "text": "Every booking from now on gets a reminder, including bookings your team adds."
        },
        {
          "start_time": 63.8,
          "text": "Check the sender name, so clients know the text is from you."
        },
        {
          "start_time": 80.3,
          "text": "Save, and you are done with the switch."
        },
        {
          "start_time": 95.7,
          "text": "Next, choose how reminders go out: text, email or both."
        },
        {
          "start_time": 108.2,
          "text": "Texts get read sooner, emails carry more detail, and you can send both."
        },
        {
          "start_time": 127.5,
          "text": "We use a text for the reminder and an email for the booking confirmation."
        },
        {
          "start_time": 150.1,
          "text": "Now the timing. We send the first reminder 48 hours before the visit."
        },
        {
          "start_time": 168.4,
          "text": "That leaves time to fill the slot if someone cancels."
        },
        {
          "start_time": 189.9,
          "text": "The second reminder goes out 2 hours before."
        },
        {
          "start_time": 207.3,
          "text": "You can change both times per service."
        },
        {
          "start_time": 228.6,
          "text": "Quick note: reminders use your business time zone."
        },
        {
          "start_time": 235.2,
          "text": "Here are six templates you can copy and paste."
        },
        {
          "start_time": 247.8,
          "text": "Template one is the short reminder with the date, time and your business name."
        },
        {
          "start_time": 268.0,
          "text": "Template two adds the service and the staff member."
        },
        {
          "start_time": 286.4,
          "text": "Template three asks for a reply to confirm."
        },
        {
          "start_time": 301.9,
          "text": "Template four is for first visits and adds directions."
        },
        {
          "start_time": 318.3,
          "text": "Template five mentions your cancellation policy."
        },
        {
          "start_time": 334.6,
          "text": "Template six is the friendly one for regulars."
        },
        {
          "start_time": 352.4,
          "text": "Now add a reply option, so clients can confirm or cancel from the text."
        },
        {
          "start_time": 371.0,
          "text": "A cancel reply frees the slot straight away and tells your team."
        },
        {
          "start_time": 395.5,
          "text": "A confirm reply marks the booking as confirmed in your calendar."
        },
        {
          "start_time": 430.8,
          "text": "Before you rely on it, test it on your own booking."
        },
        {
          "start_time": 447.3,
          "text": "Book yourself in for tomorrow and watch the reminder arrive."
        },
        {
          "start_time": 466.9,
          "text": "Reply C and check the booking turns to confirmed."
        },
        {
          "start_time": 488.2,
          "text": "Finally, find your no-show count in the dashboard."
        },
        {
          "start_time": 503.6,
          "text": "Open Reports, then No-shows, and compare this month with last month."
        },
        {
          "start_time": 526.1,
          "text": "That tells you whether the reminders are working for your business."
        },
        {
          "start_time": 548.7,
          "text": "That's it: reminders on, timing set, templates in place."
        },
        {
          "start_time": 561.0,
          "text": "The links to the guide and the templates are in the description."
        }
      ]
    },
